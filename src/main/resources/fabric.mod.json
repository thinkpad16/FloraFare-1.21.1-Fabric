{
	"schemaVersion": 1,
	"id": "florafare",
	"version": "${version}",
	"name": "FloraFare",
	"description": "A datapack-driven food overhaul: eating grants timed buffs, and combining the right dishes unlocks hidden synergies. Fully configurable, with an in-game ModMenu settings screen and a searchable culinary journal.",
	"authors": [
		"tend1tnuy"
	],
	"license": "MIT",
	"icon": "assets/florafare/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.tend1tnuy.florafare.Florafare"
		],
		"fabric-datagen": [
			"net.tend1tnuy.florafare.FlorafareDataGenerator"
		],
      "client": [
        "net.tend1tnuy.florafare.FlorafareClient"
      ],
      "appleskin": [
        "net.tend1tnuy.florafare.compat.appleskin.AppleSkinIntegration"
      ],
      "modmenu": [
        "net.tend1tnuy.florafare.compat.modmenu.FlorafareModMenuIntegration"
      ]
	},
	"mixins": [
		"florafare.mixins.json"
	],
	"depends": {
		"fabricloader": "*",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"appleskin": "*",
		"modmenu": "*"
	}
}